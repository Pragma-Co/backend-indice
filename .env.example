API_PORT=8000
DJANGO_SECRET_KEY=<random-string-at-least-50-characters>
EXCLUDED_IDENTIFIER_HMAC_KEY=<random-string-at-least-50-characters>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=password
DJANGO_SUPERUSER_EMAIL=admin@api6.local

POSTGRES_DB=api6
POSTGRES_USER=api6_admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=10

SEED_PASSWORD=password

MONGO_DB=api6
MONGO_USER=api6_admin
MONGO_PASSWORD=password
MONGO_HOST=localhost
MONGO_PORT=27017

MAX_UPLOAD_SIZE_BYTES=104857600
TEMP_UPLOAD_DIR=tmp_uploads
DOCUMENT_STORAGE_DIR=media

OLLAMA_BASE_URL=http://<ollama-host>
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# --- Backups (manage.py backup_snapshot) ---
# Directory that receives the encrypted snapshots, relative to the api container
BACKUP_DIR=backups
# AES-256-GCM key, 64 hex characters; scripts/setup_env.py generates it.
# In production the key comes from the team password manager (see README, "Key custody")
BACKUP_ENCRYPTION_KEY=<backup-encryption-key>
# Snapshots kept per database before the oldest files are removed:
# seven days of 4-hour PostgreSQL snapshots and thirty daily MongoDB snapshots
BACKUP_KEEP_POSTGRES=42
BACKUP_KEEP_MONGODB=30

# --- E-mail (LGPD communications to affected users, manage.py send_incident_notifications) ---
# In Docker the api delivers to the Mailpit container by default (web UI at http://127.0.0.1:8025,
# host port configurable via MAILPIT_PORT); point these to the client's SMTP service in production.
# django.core.mail.backends.console.EmailBackend prints the messages in the api log instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=10
MAILPIT_PORT=8025
DEFAULT_FROM_EMAIL=Índice <no-reply@indice.local>
# Contact channel of the data protection officer printed in the communications
INCIDENT_CONTACT_EMAIL=privacidade@indice.local
