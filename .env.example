# API-6 backend environment configuration (template)
#
# Preferred setup (automatic — creates .env and CREDENTIALS.txt for you):
#   Linux/macOS:        docker run --rm --user "$(id -u):$(id -g)" -v "$(pwd):/app" -w /app python:3.12-slim python scripts/setup_env.py
#   Windows PowerShell: docker run --rm -v "${PWD}:/app" -w /app python:3.12-slim python scripts/setup_env.py
#
# Manual alternative: copy this file to ".env" and replace every <...>
# placeholder with a strong random value:
#   Linux/macOS:        openssl rand -hex 16   (use -hex 32 for DJANGO_SECRET_KEY)
#   Windows PowerShell: -join (1..32 | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })   (use 1..64 for DJANGO_SECRET_KEY)

# --- Django ---
# Host port for the API. Change it if 8000 is already in use on your machine.
API_PORT=8000
DJANGO_SECRET_KEY=<random-string-at-least-50-characters>
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vue.js dev server origins allowed to call the API from the browser
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default admin user for http://localhost:8000/admin/, created automatically
# on container start (idempotent — see core/management/commands/ensure_superuser.py)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=<random-password>
DJANGO_SUPERUSER_EMAIL=admin@api6.local

# --- PostgreSQL (relational database) ---
POSTGRES_DB=api6
POSTGRES_USER=api6_admin
POSTGRES_PASSWORD=<random-password>
POSTGRES_HOST=localhost
# Host-side port only; inside Docker the database always listens on 5432.
# 5433 by default so it never clashes with a PostgreSQL installed locally.
POSTGRES_PORT=5433

# --- MongoDB (non-relational database) ---
MONGO_DB=api6
MONGO_USER=api6_admin
MONGO_PASSWORD=<random-password>
MONGO_HOST=localhost
# Host-side port only; inside Docker the database always listens on 27017.
# 27018 by default so it never clashes with a MongoDB installed locally.
MONGO_PORT=27018

# --- File upload (temporary storage) ---
# Maximum accepted file size in bytes (default: 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600
# Directory where uploaded files are temporarily stored before confirmation
TEMP_UPLOAD_DIR=tmp_uploads
