    DOCUMENT {
        string code
        string title
        string confidentiality_level
        datetime archived_at
    }
    REVISION {
        int version
        string status "PENDING / APPROVED / REJECTED"
        string change_description
        string auditor_comment
    }
    FILE {
        string original_name
        string sha256
        string storage_path
        uuid file_group "same file across versions"
        bool revision_changed
    }
    DOCUMENT_CONTENT {
        text content
        string[] thematic_tags
        tsvector search_vector
    }
    AUDIT_LOG {
        string action
        string entity
        json record
    }
    EXCLUDED_IDENTIFIER {
        string identifier_hash
    }
    SECRECY_LEVEL {
        string code "PUBLIC / CONFIDENTIAL / SECRET"
        int rank
        string visibility "EVERYONE / AREA / SELECTED_USERS"
    }
    ACCESS_GROUP {
        string name
        string scope "AREA / PROJECT"
        bool active
    }
    NOTIFICATION {
        string type
        string title
        datetime read_at
    }
    DATA_INCIDENT {
        string type
        string severity
        string status
    }
    BACKUP_RUN {
        string target
        string status
        bool encrypted
    }
